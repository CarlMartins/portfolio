<style>
	body {
		margin: 0;
		font-family: system-ui, sans-serif;
		background: #09090b;
		color: #fafafa;
	}

	main {
		min-height: 100vh;

		display: flex;
		flex-direction: column;

		justify-content: center;
		align-items: center;
	}

	h1 {
		font-size: 3rem;
		margin: 0;
	}

	p {
		color: #a1a1aa;
	}

	.social-links {
		display: flex;
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.social-links a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		color: #a1a1aa;
		border: 1px solid #27272a;
		border-radius: 999px;
		transition: color 160ms ease, border-color 160ms ease, transform 160ms ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: #fafafa;
		border-color: #fafafa;
		transform: translateY(-2px);
	}

	.social-links a:focus-visible {
		outline: 2px solid #fafafa;
		outline-offset: 3px;
	}

	.social-links svg {
		width: 1.25rem;
		height: 1.25rem;
		fill: currentColor;
	}
</style>
